# Copy to `deploy/digitalocean/pilot.env` before running Docker Compose.
#
# Important:
# - This pilot stack is designed for one DigitalOcean Droplet.
# - Keep a single `web` replica. The app currently uses process-local read cache and rate limiting.
# - This stack includes Redis and the standalone realtime service.
# - `VS_DEPLOY_ENV=staging` is intentional for this pilot: it preserves strict HTTPS/cookie/origin
#   behavior without forcing Redis TLS (`rediss://`) on the same box. Move to `production` only
#   after using managed TLS Redis or a local TLS proxy for Redis.

NODE_ENV=production
VS_DEPLOY_ENV=staging

APP_DOMAIN=716fm.com
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=replace-with-a-long-random-password
# Same password URL-encoded for app connections. If POSTGRES_PASSWORD contains symbols,
# generate this with:
#   python3 -c 'import os, urllib.parse; print("DATABASE_URL=postgresql://listen:" + urllib.parse.quote(os.environ["POSTGRES_PASSWORD"], safe="") + "@postgres:5432/listen")'
DATABASE_URL=postgresql://listen:replace-with-url-encoded-postgres-password@postgres:5432/listen

# Optional shared Last.fm API key. Leave blank when users provide their own keys.
LASTFM_API_KEY=

VS_PUBLIC_APP_ORIGIN=https://716fm.com
VS_WEB_INTERNAL_ORIGIN=http://web:3000
VS_TRUST_PROXY_HEADERS=true
VS_INTERNAL_API_SECRET=replace-with-at-least-32-random-chars

LISTEN_REALTIME_ENABLED=true
REALTIME_JWT_SECRET=replace-with-at-least-32-random-chars
LISTEN_REALTIME_PORT=3457
LISTEN_REALTIME_WS_URL=wss://716fm.com
NEXT_PUBLIC_LISTEN_REALTIME_WS_URL=wss://716fm.com

EXPORT_ARTIFACT_RETENTION_SEC=86400
EXPORT_ARTIFACT_CLEANUP_BATCH=100
LISTEN_SYNC_USER_MIN_INTERVAL_SEC=300

BULLMQ_WORKER_CONCURRENCY_IMPORTS=1
BULLMQ_WORKER_CONCURRENCY_EXPORTS=1
BULLMQ_WORKER_CONCURRENCY_ANALYTICS=1
BULLMQ_WORKER_CONCURRENCY_SYNC=1
BULLMQ_WORKER_CONCURRENCY_INCREMENTAL_SYNC=1

IMPORT_LASTFM_PAGE_MIN_INTERVAL_MS=1000
IMPORT_LASTFM_PAGE_BURST=1
IMPORT_CANONICALIZATION_BATCH_SIZE=100
IMPORT_CANONICALIZATION_BATCHES_PER_PAGE=1

VS_EMAIL_ENABLED=true
VS_EMAIL_TRANSPORT=mailgun
MAILGUN_API_KEY=replace-with-mailgun-api-key
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=716FM <hello@example.com>
MAILGUN_REGION=us

# Optional welcome email behavior: off | signup | email_verified
VS_WELCOME_EMAIL=off
