# 716FM — copy to .env and adjust for your machine.
# Single-user self-host: leave VS_EMAIL_ENABLED unset/false (no Mailgun required).
# First boot: open /setup to create the sole owner account.

# read DATABASE_URL at process startup.

# Required — PostgreSQL connection string (postgres:// or postgresql://)
DATABASE_URL=postgresql://listen:listen@127.0.0.1:55432/listen

# Required for BullMQ unless you opt out below — Redis URL (redis:// or rediss://). Compose maps host port 56379.
# Production deploys (VS_DEPLOY_ENV=production or inferred) require rediss:// (TLS).
REDIS_URL=redis://127.0.0.1:56379

# Optional — absolute directory shared by the worker (writes) and Next.js (reads) for completed
# listen-export ZIPs. When unset, defaults under the OS temp directory (not durable across reboots).
# EXPORT_ARTIFACTS_DIR=/absolute/path/to/export-artifacts

# Optional — defaults to development when unset
NODE_ENV=development

# Optional — deployment tier for secret validation: development | staging | production | test.
# When unset, inferred from NODE_ENV (production Node without VS_DEPLOY_ENV is treated as production rules).
# Staging/production: EXPORT_ARTIFACTS_DIR required; skipRedisQueues forbidden; VS_LOCAL_SEED_PASSWORD forbidden.
# Production additionally requires REDIS_URL to use rediss://. See packages/env/src/tier-matrix.ts.
# Staging/production: VS_TRUST_PROXY_HEADERS must be "true" or "false" (use true only when ingress overwrites forwarded headers).
# Staging/production: VS_PUBLIC_APP_ORIGIN=https://your-public-host (canonical origin for HTTPS redirects and auth Host checks).
# Realtime: set LISTEN_REALTIME_ENABLED=false for HTTP-only strict deploys, or true with REALTIME_JWT_SECRET (≥32).
# VS_DEPLOY_ENV=development

# Required for real Last.fm imports — get a key at https://www.last.fm/api/account/create
# When unset, queued jobs fail with a clear error stored on the import row and shown in the UI.
# LASTFM_API_KEY=

# Optional — minimum seconds between background listen-sync enqueue attempts per user (worker).
# Default 120; range 30–86400.
# LISTEN_SYNC_USER_MIN_INTERVAL_SEC=

# Optional — WebSocket listen push (`npm run dev:realtime` / `npm run run:all`).
# `run:all` always starts realtime, which requires REALTIME_JWT_SECRET (≥16 chars in development; ≥32 in staging/production).
# LISTEN_REALTIME_ENABLED=true
# REALTIME_JWT_SECRET= # openssl rand -base64 48
# LISTEN_REALTIME_WS_URL=ws://127.0.0.1:3457
# NEXT_PUBLIC_LISTEN_REALTIME_WS_URL=ws://127.0.0.1:3457
# LISTEN_REALTIME_PORT=3457

# Optional — 32-byte AES-256-GCM key (base64url/base64/hex) to encrypt per-user secrets
# at rest (users.lastfm_api_key). Generate with: openssl rand -base64 32
# When unset, Last.fm keys are stored plaintext (acceptable for local single-user only).
# VS_SECRETS_ENCRYPTION_KEY=

# Optional — Bearer secret for operator-only HTTP routes under /api/internal/* (e.g. legacy analytics snapshot POST).
# When unset, those routes return 503 internal_api_disabled. Staging/production: ≥32 chars when set; development/test: ≥16 when set.
# VS_INTERNAL_API_SECRET=

# Required in staging/production (≥32 chars). Gates first-run and post-delete /setup so an empty users table
# cannot be claimed by anyone who can reach the host. Development/test: optional (≥16 when set).
# VS_SETUP_BOOTSTRAP_SECRET=

# Optional — password for the local seed account (`npm run db:seed:local`). Defaults to
# `dev-local-listen` when unset. Development/test only; forbidden in staging/production.
# VS_LOCAL_SEED_PASSWORD=

# Optional — one-shot operator CLI for `users.account_role` (`npm run db:bootstrap:account-role`).
# Not read by the web server or worker. Normal installs use /setup (creates owner) instead.
# VS_BOOTSTRAP_ACCOUNT_ROLE_EMAIL=you@your-domain.example
# VS_BOOTSTRAP_ACCOUNT_ROLE=owner

# Optional — base URL for `npm run smoke:local` (default http://127.0.0.1:3456; matches `next dev -p 3456`)
# SMOKE_BASE_URL=

# Optional — per-bucket job sample cap for `npm run inspect:bullmq-queues` (0–500; validated via @vs/env; unset uses package default)
# VS_QUEUE_INSPECT_JOB_SAMPLE_LIMIT=

# Optional — stale-running probe window in seconds for `npm run inspect:stalled-db-jobs` (1–86400; default 600 when unset)
# VS_STALLED_JOB_PROBE_SECONDS=

# Optional — JSON object toggling registered feature flags (see packages/feature-flags/src/keys.ts).
# Set skipRedisQueues to run web + worker without Redis (imports/exports enqueue return 503; worker skips BullMQ).
# signupsDisabled is unused in 716FM (no public signup; use /setup once).
# FEATURE_FLAGS={"skipRedisQueues":true}
# FEATURE_FLAGS={"signupsDisabled":true}
# FEATURE_FLAGS={"skipRedisQueues":true,"signupsDisabled":true}

# Optional — BullMQ worker concurrency per queue (worker only). Integers 1–64; safe defaults apply when unset.
# BULLMQ_WORKER_CONCURRENCY_SMOKE_TEST=1
# BULLMQ_WORKER_CONCURRENCY_IMPORTS=2
# BULLMQ_WORKER_CONCURRENCY_EXPORTS=1
# BULLMQ_WORKER_CONCURRENCY_ANALYTICS=1
# BULLMQ_WORKER_CONCURRENCY_SYNC=2
# BULLMQ_WORKER_CONCURRENCY_INCREMENTAL_SYNC=2

# Optional — Last.fm page pacing inside each import job (worker). Default 200 ms gap after the first 3 pages; set min interval to 0 to disable (tests only).
# IMPORT_LASTFM_PAGE_MIN_INTERVAL_MS=
# IMPORT_LASTFM_PAGE_BURST=

# Optional — outbound email. When VS_EMAIL_ENABLED=true, VS_EMAIL_TRANSPORT selects behavior:
#   capture (default in dev/test): logs + in-memory capture; no Mailgun HTTP; omit all MAILGUN_* or set the full set together.
#   noop: succeed without network or capture (good for fast tests).
#   mailgun: real Mailgun HTTP. Required in staging/production when email is enabled. In dev/test, also set VS_EMAIL_ALLOW_UNSAFE_MAILGUN=true.
# When transport is mailgun, MAILGUN_API_KEY (≥32 chars), MAILGUN_DOMAIN, and MAILGUN_FROM are required.
# When email is disabled, do not set MAILGUN_* (partial config fails startup validation). Region defaults to US API hosts unless MAILGUN_REGION=eu.
VS_EMAIL_ENABLED=false
# VS_EMAIL_ENABLED=true|false
# VS_EMAIL_TRANSPORT=mailgun|capture|noop
# VS_EMAIL_ALLOW_UNSAFE_MAILGUN=true|false
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM=
# MAILGUN_REGION=us|eu
# Local smoke: `npm run mailer:smoke` (optional MAILER_SMOKE_TO + MAILER_SMOKE_DISPATCH=true; external POST only when transport=mailgun).
